# MongoDB Connection String (leave blank or replace with your MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/credit_risk_db?retryWrites=true&w=majority
MONGODB_URI=

# Database Name
DATABASE_NAME=credit_risk_db

# Flask Server Port
PORT=5000
DEBUG=True

# Demonstration Interest Rate (% per annum)
DEMO_INTEREST_RATE=9.5
